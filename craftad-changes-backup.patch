+  rejectApplication: (token, id) => request(`/api/applications/${id}/reject`, { method: "PATCH" }, token),
+  review: (token, jobId, body) => request(`/api/reviews/${jobId}`, { method: "POST", body: JSON.stringify(body) }, token),
